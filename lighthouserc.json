{
  "ci": {
    "collect": {
      "staticDistDir": "./out",
      "url": ["http://localhost/index.html", "http://localhost/destinations/india.html"],
      "numberOfRuns": 2
    },
    "assert": {
      "assertions": {
        "categories:performance": ["error", { "minScore": 0.5 }],
        "largest-contentful-paint": ["error", { "maxNumericValue": 9000 }],
        "cumulative-layout-shift": ["error", { "maxNumericValue": 0.1 }],
        "total-byte-weight": ["error", { "maxNumericValue": 4000000 }],
        "unused-javascript": ["warn", { "maxNumericValue": 50000 }]
      }
    },
    "upload": { "target": "temporary-public-storage" }
  }
}
