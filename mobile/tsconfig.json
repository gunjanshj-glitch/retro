{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@/assets/*": [
        "./assets/*"
      ],
      "@retro/core/*": [
        "../packages/core/*"
      ],
      "@retro/api-client": [
        "../packages/api-client/index.ts"
      ],
      "@retro/api-client/*": [
        "../packages/api-client/*"
      ],
      "@retro/chat-flow": [
        "../packages/chat-flow/index.ts"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts",
    "../packages/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}